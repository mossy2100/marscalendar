{#
/**
 * @file
 * Site branding: the banner image (the theme logo) and the slogan.
 *
 * Available variables:
 * - site_logo: The logo URL, if enabled in the block configuration.
 * - site_name: The site name, if enabled in the block configuration.
 * - site_slogan: The site slogan, if enabled in the block configuration.
 */
#}
<div class="mdc-branding">
  {% if site_logo %}
    <a class="mdc-branding__logo" href="{{ path('<front>') }}" rel="home">
      <img src="{{ site_logo }}" alt="{{ site_name ?: 'Home'|t }}">
    </a>
  {% elseif site_name %}
    <a class="mdc-branding__name" href="{{ path('<front>') }}" rel="home">{{ site_name }}</a>
  {% endif %}
  {% if site_slogan %}
    <p class="mdc-branding__slogan">{{ site_slogan }}</p>
  {% endif %}
</div>
