<?php

/**
 * @file
 * Datetime converter, calendar pages, and Mars clock for the Utopian Calendar.
 */

declare(strict_types=1);

/**
 * Implements hook_theme().
 */
function utopian_theme(): array {
  return [
    'utopian_datetime_converter' => [
      'variables' => ['mars_time_zones' => []],
    ],
    'utopian_calendar_pages' => [
      'variables' => ['events' => [], 'sol_headings' => [], 'months' => []],
    ],
    'utopian_clock' => [
      'variables' => ['mars_time_zones' => []],
    ],
  ];
}
